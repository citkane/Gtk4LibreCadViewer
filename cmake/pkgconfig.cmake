include(GNUInstallDirs)
include(CMakePackageConfigHelpers)

set(LIB_DIR "${CMAKE_INSTALL_LIBDIR}")
set(BIN_DIR "${CMAKE_INSTALL_BINDIR}")
set(INC_DIR "${CMAKE_INSTALL_INCLUDEDIR}/${PROJECT_NAME}")
set(CONF_DIR "${CMAKE_INSTALL_LIBDIR}/cmake/${PROJECT_NAME}")
set(CONF_FILE "${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_NAME}Config.cmake")
set(CONF_FILE_IN "${CMAKE_CURRENT_LIST_DIR}/${PROJECT_NAME}Config.cmake.in")

configure_package_config_file(
  ${CONF_FILE_IN} ${CONF_FILE}
  INSTALL_DESTINATION "${CONF_DIR}"
  INSTALL_PREFIX "${CMAKE_INSTALL_PREFIX}"
  PATH_VARS INC_DIR LC_INCLUDE_DIR LIB_DIR BIN_DIR)
